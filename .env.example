# ============================================================
# AutoTok Pessoal - variaveis de ambiente
# Copie para .env e preencha. Nenhuma chave real deve ir pro git.
# ============================================================

# --- Obrigatorio: banco de dados Postgres ---------------------
# Use Neon (neon.tech, free) ou Supabase, para que tanto o app
# quanto o GitHub Actions consigam acessar o mesmo banco.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# --- Obrigatorio: acesso ao painel -----------------------------
# Senha unica que voce digita no iPhone para entrar.
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessao (gere: openssl rand -hex 32).
# Sem terminal? Digite 40+ caracteres aleatorios no teclado — serve igual.
AUTH_SECRET=troque-por-32-bytes-aleatorios
# OPCIONAL na Vercel: sem esta variavel, o endereco do proprio deploy e usado.
# Preencha se voce usa dominio proprio ou roda fora da Vercel.
# APP_URL=https://seuapp.exemplo.com

# --- Obrigatorio: IA que escreve os roteiros -------------------
# gemini | groq | openrouter | ollama | anthropic
# Os quatro primeiros tem uso gratuito. Preencha apenas o do escolhido.
AI_PROVIDER=gemini

# GRATIS, sem cartao de credito. Pegue em aistudio.google.com/apikey
# Free tier bem acima do uso desta aplicacao e o melhor portugues entre
# as opcoes gratuitas — por isso e o padrao.
GEMINI_API_KEY=
# Deixe vazio: o padrao aponta para o Flash estavel atual e, se ele for
# aposentado, a aplicacao pergunta ao Google qual usar.
GEMINI_MODEL=
# So mexa nisto se usar um gateway/proxy no lugar da API oficial.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# GRATIS, sem cartao. Pegue em console.groq.com/keys
# Alternativa muito rapida, com Llama 3.3 70B.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Modelos marcados com ":free" em openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 100% local: nenhuma chave, nenhum limite, nada sai da sua maquina.
# Precisa do Ollama rodando (ollama.com) e de um VPS ou computador ligado.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# PAGO por uso. Melhor qualidade, mas quebra o custo zero.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Obrigatorio: TikTok (developers.tiktok.com) ---------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# OPCIONAL: por padrao vira <endereco do app>/api/tiktok/callback, que e o
# valor que voce deve cadastrar no portal. Preencha so se precisar de outro.
# TIKTOK_REDIRECT_URI=

# --- Armazenamento de midia (S3/R2) ----------------------------
# Obrigatorio se o render roda no GitHub Actions (runner e efemero).
# Cloudflare R2 tem 10GB gratis e e compativel com S3.
STORAGE_DRIVER=s3            # s3 | local
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=autotok
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publica do bucket (R2 public bucket ou dominio customizado)
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Banco de imagens/videos de fundo (gratis) -----------------
# pexels.com/api - chave gratuita, essencial para o visual dos videos
PEXELS_API_KEY=

# --- Narracao (TTS) --------------------------------------------
# edge = gratis (Microsoft Edge TTS, otimo em pt-BR) | elevenlabs = pago
TTS_PROVIDER=edge
TTS_VOICE=pt-BR-ThalitaMultilingualNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Disparo dos jobs pesados no GitHub Actions ----------------
# Token classico com escopo "repo" para disparar workflows
GITHUB_TOKEN=
GITHUB_REPO=guisegredo18-bit/autotok-pessoal

# --- Notificacao no iPhone quando um video fica pronto ---------
# ntfy.sh e gratis e tem app na App Store. Escolha um topico secreto.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Preferencias de conteudo ----------------------------------
TREND_COUNTRY=BR
TREND_LANGUAGE=pt-BR

# ============================================================
# Painel de comissoes (aba "Grana")
# Tudo aqui e opcional: sem estas chaves o resto da aplicacao
# funciona igual, so a aba de comissoes fica vazia.
# Estas variaveis tambem podem ser preenchidas pela tela
# Configuracoes > Chaves, sem mexer em arquivo nenhum.
# ============================================================

# --- Hotmart (developers.hotmart.com > Credenciais) ------------
# OAuth2 client_credentials: nao ha tela de autorizacao, as
# credenciais ja representam a sua conta.
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
# OPCIONAL: o painel da Hotmart mostra este valor pronto. Deixando
# vazio, a aplicacao calcula (base64 de client_id:client_secret).
HOTMART_BASIC=
# So mexa para apontar a sandbox.
# HOTMART_AUTH_URL=https://api-sec-vlc.hotmart.com
# HOTMART_API_URL=https://developers.hotmart.com

# --- Amazon Associates (Product Advertising API 5.0) -----------
# afiliados.amazon.com.br > Ferramentas > API de Publicidade de Produtos.
# ATENCAO: contas novas so recebem cota depois das primeiras vendas
# qualificadas. Ate la, use a importacao do CSV de ganhos.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Tag de afiliado — e ela que credita a comissao nos links.
AMAZON_PARTNER_TAG=
# Marketplace da sua conta. Define o host, a regiao da assinatura e a
# moeda assumida no CSV de ganhos.
AMAZON_MARKETPLACE=www.amazon.com.br
