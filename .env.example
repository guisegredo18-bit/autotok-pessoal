# ============================================================
# AutoTok Pessoal - variaveis de ambiente
# Copie para .env e preencha. Nenhuma chave real deve ir pro git.
# ============================================================

# --- Obrigatorio: banco de dados Postgres ---------------------
# Use Neon (neon.tech, free) ou Supabase, para que tanto o app
# quanto o GitHub Actions consigam acessar o mesmo banco.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# --- Obrigatorio: acesso ao painel -----------------------------
# Senha unica que voce digita no iPhone para entrar.
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessao (gere: openssl rand -hex 32)
AUTH_SECRET=troque-por-32-bytes-aleatorios
# URL publica da aplicacao (sem barra no final)
APP_URL=https://seuapp.exemplo.com

# --- Obrigatorio: IA que escreve os roteiros -------------------
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado para roteiros. claude-sonnet-5 sai mais barato se voce
# gerar muitos videos por dia e ja entrega roteiro bom.
ANTHROPIC_MODEL=claude-opus-5

# --- Obrigatorio: TikTok (developers.tiktok.com) ---------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Deve bater exatamente com o Redirect URI cadastrado no portal:
TIKTOK_REDIRECT_URI=https://seuapp.exemplo.com/api/tiktok/callback

# --- Armazenamento de midia (S3/R2) ----------------------------
# Obrigatorio se o render roda no GitHub Actions (runner e efemero).
# Cloudflare R2 tem 10GB gratis e e compativel com S3.
STORAGE_DRIVER=s3            # s3 | local
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=autotok
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publica do bucket (R2 public bucket ou dominio customizado)
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Banco de imagens/videos de fundo (gratis) -----------------
# pexels.com/api - chave gratuita, essencial para o visual dos videos
PEXELS_API_KEY=

# --- Narracao (TTS) --------------------------------------------
# edge = gratis (Microsoft Edge TTS, otimo em pt-BR) | elevenlabs = pago
TTS_PROVIDER=edge
TTS_VOICE=pt-BR-ThalitaMultilingualNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Disparo dos jobs pesados no GitHub Actions ----------------
# Token classico com escopo "repo" para disparar workflows
GITHUB_TOKEN=
GITHUB_REPO=guisegredo18-bit/autotok-pessoal

# --- Notificacao no iPhone quando um video fica pronto ---------
# ntfy.sh e gratis e tem app na App Store. Escolha um topico secreto.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Preferencias de conteudo ----------------------------------
TREND_COUNTRY=BR
TREND_LANGUAGE=pt-BR
