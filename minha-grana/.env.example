# ============================================================
# Minha Grana — variaveis de ambiente
# Copie para .env e preencha. Nenhuma chave real deve ir pro git.
#
# Sao apenas TRES variaveis obrigatorias. As credenciais da
# Hotmart e da Amazon voce registra dentro do proprio aplicativo,
# em Configuracoes — elas ficam cifradas no banco.
# ============================================================

# --- Obrigatorio: banco de dados Postgres ---------------------
# Use Neon (neon.tech, gratis) ou Supabase.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# --- Obrigatorio: acesso ao painel -----------------------------
# Senha unica que voce digita no iPhone para entrar.
APP_PASSWORD=troque-esta-senha

# Segredo que assina o cookie de sessao E cifra suas credenciais
# no banco (gere: openssl rand -hex 32). Sem terminal? Digite 40+
# caracteres aleatorios no teclado — serve igual.
#
# ATENCAO: se este valor mudar, as chaves da Hotmart e da Amazon
# guardadas no banco deixam de ser decifradas e precisam ser
# registradas de novo. O painel avisa quando isso acontece, em vez
# de deixar parecer que voce esqueceu de preencher.
AUTH_SECRET=troque-por-32-bytes-aleatorios

# OPCIONAL na Vercel: sem esta variavel, o endereco do proprio
# deploy e usado. Preencha se voce usa dominio proprio.
# APP_URL=https://suagrana.exemplo.com

# ============================================================
# Daqui para baixo e tudo OPCIONAL.
# O caminho recomendado e registrar estas chaves pela tela de
# Configuracoes do aplicativo. Estas variaveis existem para quem
# roda local e prefere um .env — quando definidas, elas vencem o
# que estiver salvo no banco.
# ============================================================

# --- Hotmart (developers.hotmart.com > Credenciais) ------------
# OAuth2 client_credentials: nao ha tela de autorizacao, as
# credenciais ja representam a sua conta.
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
# OPCIONAL: o painel da Hotmart mostra este valor pronto. Deixando
# vazio, a aplicacao calcula (base64 de client_id:client_secret).
HOTMART_BASIC=
# So mexa para apontar a sandbox.
# HOTMART_AUTH_URL=https://api-sec-vlc.hotmart.com
# HOTMART_API_URL=https://developers.hotmart.com

# --- Amazon Associates (Product Advertising API 5.0) -----------
# afiliados.amazon.com.br > Ferramentas > API de Publicidade de Produtos.
# ATENCAO: contas novas so recebem cota depois das primeiras vendas
# qualificadas. Ate la, use a importacao do CSV de ganhos, que
# funciona desde o primeiro dia.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# Tag de afiliado — e ela que credita a comissao nos links.
AMAZON_PARTNER_TAG=
# Marketplace da sua conta. Define o host da API, a regiao da
# assinatura e a moeda assumida na leitura do CSV de ganhos.
AMAZON_MARKETPLACE=www.amazon.com.br
