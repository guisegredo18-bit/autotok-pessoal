{
  "name": "autotok-pessoal",
  "version": "1.0.0",
  "private": true,
  "description": "Analisa tendencias do TikTok, produz videos automaticamente e publica apos aprovacao pelo iPhone.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "scan": "tsx scripts/scan-trends.ts",
    "ideas": "tsx scripts/generate-ideas.ts",
    "render": "tsx scripts/render-video.ts",
    "publish": "tsx scripts/publish-video.ts",
    "queue": "tsx scripts/run-queue.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "drizzle-orm": "^0.38.3",
    "jose": "^5.9.6",
    "libsodium-wrappers": "^0.8.4",
    "msedge-tts": "^1.3.4",
    "next": "^15.1.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
